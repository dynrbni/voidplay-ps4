{
  "name": "voidplay-ps4",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "node --test src/*.test.ts shared/*.test.ts",
    "test:e2e": "node --test e2e/store.test.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run catalog:validate && npm run build && npm run admin:build",
    "admin:dev": "vite --config admin/vite.config.ts",
    "admin:build": "tsc --noEmit && vite build --config admin/vite.config.ts",
    "admin:preview": "vite preview --config admin/vite.config.ts",
    "catalog:validate": "node scripts/catalog-cli.ts validate",
    "catalog:import": "node scripts/catalog-cli.ts import",
    "test:admin": "node --test e2e/admin.test.mjs",
    "verify:public": "node scripts/verify-public.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5"
  }
}
