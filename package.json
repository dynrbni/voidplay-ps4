{
  "name": "voidplay-ps4",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "node --test src/*.test.ts shared/*.test.ts server/*.test.ts",
    "test:e2e": "node --test e2e/store.test.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run catalog:validate && npm run build && npm run admin:build",
    "admin:dev": "vite --config admin/vite.config.ts",
    "admin:build": "tsc --noEmit && vite build --config admin/vite.config.ts",
    "admin:preview": "vite preview --config admin/vite.config.ts",
    "catalog:validate": "node scripts/catalog-cli.ts validate",
    "catalog:import": "node scripts/catalog-cli.ts import",
    "test:admin": "node --test e2e/admin.test.mjs",
    "verify:public": "node scripts/verify-public.ts",
    "native:test": "./native/diagnostic/test-host.sh",
    "native:doctor": "python3 -B framework/voidplay-native/tools/cli.py doctor",
    "native:preview": "python3 -B framework/voidplay-native/tools/cli.py mac-run",
    "native:watch": "python3 -B framework/voidplay-native/tools/cli.py mac-watch",
    "native:runtime:test": "sh framework/voidplay-native/tools/test-portable.sh",
    "native:mac:smoke": "python3 -B framework/voidplay-native/tools/cli.py mac-smoke",
    "native:ps4:build": "python3 -B framework/voidplay-native/tools/cli.py ps4-build",
    "native:ps4:verify": "python3 -B framework/voidplay-native/tools/cli.py ps4-verify",
    "owner:setup": "node scripts/setup-owner.ts",
    "owner:serve": "npm run admin:build && node server/owner.ts",
    "pages:build": "node scripts/pages.ts build",
    "pages:deploy": "node scripts/pages.ts deploy",
    "test:owner": "node --test server/*.test.ts",
    "react:doctor": "npm --prefix framework/ps4-react run doctor",
    "react:test": "npm --prefix framework/ps4-react test",
    "react:preview": "npm --prefix framework/ps4-react run preview",
    "react:smoke": "npm --prefix framework/ps4-react run smoke",
    "react:ps4:build": "npm --prefix framework/ps4-react run build:ps4",
    "react:ps4:verify": "npm --prefix framework/ps4-react run verify:ps4"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5"
  }
}
